# ============================================================================
#  BidCraft 标书匠 —— 环境配置模板
#
#  用法：复制本文件为项目根目录的 .env，按下方说明填写后启动。
#      cp .env.example .env
#
#  ⚠️ .env 含有密钥，已在 .gitignore 中，永远不会被提交。
#     请勿把真实密钥写进 README、代码或任何会被分享的文件。
# ============================================================================


# ============================ 必填项（3 项） ============================

# ---------- ① MySQL 数据库 ----------
# 随便一个 MySQL 8 实例即可（本机安装 / 局域网 / 云数据库都行）。
# 建库语句：CREATE DATABASE bid_chat_db DEFAULT CHARSET utf8mb4 COLLATE utf8mb4_general_ci;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bid_chat_db

# ---------- ② 大模型（阿里云百炼 / DashScope，OpenAI 兼容接口）----------
# 申请地址：https://bailian.console.aliyun.com  →  API-KEY 管理
# 本项目用 httpx 直连 OpenAI 兼容端点，不依赖任何厂商 SDK，因此任何
# OpenAI 兼容服务都可以替换（改 LLM_BASE_URL 即可）。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 文本与视觉统一用一个模型即可（正文生成、知识提炼、图表理解都用它）
TEXT_MODEL=qwen3.8-flash
VISION_MODEL=qwen3.8-flash
# 关闭思考模式用哪个请求参数：百炼用 enable_thinking；不认它的中转站改 reasoning_effort
# （不设则默认 enable_thinking）；端点完全不支持时设 none。
LLM_THINKING_PARAM=enable_thinking

# ---------- ③ MinerU 文档解析服务 ----------
# 用途：解析 PDF / 扫描件 / 图片型招标文件（OCR + 版面还原）。
# 申请地址：https://mineru.net  →  API 管理  →  创建 Token
# 注意：Token 有有效期，过期后需重新生成并更新此值。
MINERU_API_TOKEN=


# ============================ 可选项 ============================

# ---------- 缺图自动生成（千问原生文生图接口）----------
# 只补允许合成的概念示意插图；真实材料继续待补，关系图走 Mermaid。
# 生图会产生模型调用费用。默认同地域复用 LLM_API_KEY；模型需已开通。
IMAGE_GENERATION_ENABLED=true
IMAGE_GENERATION_MODEL=qwen-image-2.0
# 留空时从百炼 LLM_BASE_URL 推导原生接口（不是 compatible-mode 地址）。
# 若 LLM_BASE_URL 换成了第三方中转站，这里必须显式填百炼原生接口：
# https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
IMAGE_GENERATION_ENDPOINT=
# 若接口主机不同，须单独填写对应服务 Key，不跨服务复用密钥。
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_SIZE=1536*1024
IMAGE_GENERATION_TIMEOUT=120
IMAGE_GENERATION_MAX_PER_CHAPTER=2
IMAGE_GENERATION_CONCURRENCY=2

# ---------- 数据库 ----------

# ---------- MinerU ----------
MINERU_API_BASE=https://mineru.net/api/v4
# 解析引擎。留空/不设则用 pipeline（通用）。
# 如你的套餐支持新版 VLM 引擎，可设为 vlm 或具体版本号（如 vlm3.4.4），
# 复杂版面与表格还原通常更好。
#MINERU_MODEL_VERSION=vlm
# 结果下载 CDN 的 IP 兜底（逗号分隔多个）。仅当本机 DNS 被代理污染、
# 导致 cdn-mineru.openxlab.org.cn 解析失败报 TLS 错误时才需要填。
# 留空则走系统正常 DNS。
#MINERU_CDN_IPS=

# ---------- 对话 Agent 专用模型（可选）----------
# 留空则对话链路回退使用上面的 TEXT_MODEL。
# 若希望对话用指令遵循更强的模型（如更大参数的版本），可单独配置；
# 支持指向另一个 OpenAI 兼容端点。
#CHAT_BASE_URL=
#CHAT_API_KEY=
#CHAT_MODEL=

# ---------- 领域 ----------
# 系统默认领域（app/core/domains.py 注册表里的 key）。
# 上传知识文档 / 新建项目未显式指定领域时用它，也是未知 key 的回退值。
# 各领域的专业标签词表与知识库互相隔离：项目的领域决定它匹配哪个领域的知识页。
# 可选值见 GET /api/domains（内置：lowalt=低空/无人机，railway=铁路工程，softtest=软件测试）。
DEFAULT_DOMAIN=lowalt
# 当前仅编制该章及其子节，保留招标文件原章节编号；留空恢复整份目录。
GENERATION_ROOT_TITLE=技术方案

# ---------- 运行行为 ----------
# 真实分页、目录更新（可选；不配置时仍可导出带目录域的 Word，打开后更新域）。
# 指向含 Python/UNO 的 LibreOffice program/soffice.com（Windows）或 soffice。
#DOCX_RENDERER_PATH=C:/Program Files/LibreOffice/program/soffice.com
DOCX_RENDERER_TIMEOUT=240
# 后端启动时自动续跑被中断的编制任务（从 MySQL 检查点恢复）。
# 默认 false：中断后等你自己决定要不要继续。
COMPILE_AUTO_RESUME=false

# 解析缓存：同一文件（内容 MD5 相同）此前已解析过，则复用解析产物，
# 不再重复消耗 MinerU 配额。默认 true，建议保持开启。
REUSE_PARSED_BY_MD5=true

# 调试开关：把逐章生成正文时实际发给模型的完整上下文，随 SSE 一起
# 返回并在浏览器控制台打印。排查"生成结果与预期差距大"时很有用，
# 平时请保持关闭（会显著增大传输量）。
GEN_DEBUG_CONTEXT=false

# 公司口径：交付与验收流程照常写，但正文、提纲、目录不出现具体交付文件
# 名称、份数和交付物清单。生成/改写/落库/导出都会过一遍清洗。
# 默认 true；设为 false 可恢复上游行为。
BIDCRAFT_HIDE_DELIVERABLE_FILES=true
